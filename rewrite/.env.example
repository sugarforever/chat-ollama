# Copy to .env; replace before starting. Do not commit .env.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ORIGIN=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
# Containers reach host services through host.docker.internal, not localhost.
# The host provider must listen on an interface accessible from Docker.
CHAT_BASE_URL=http://host.docker.internal:11434/v1
CHAT_MODEL_ID=
CHAT_API_KEY=
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL_ID=
EMBEDDING_API_KEY=
