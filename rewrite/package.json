{
  "name": "chat-ollama-rewrite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build && esbuild src/lib/server/startup.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=build/startup.js",
    "dev": "vite dev",
    "start": "node server.mjs",
    "desktop:dev": "pnpm build && node desktop/dev.mjs",
    "desktop:prepare": "pnpm build && node desktop/prepare.mjs",
    "desktop:package": "pnpm desktop:prepare && electron-builder --config desktop/electron-builder.yml --mac --publish never",
    "desktop:smoke": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@lucide/svelte": "1.72.0",
    "@modelcontextprotocol/sdk": "1.25.3",
    "@sinclair/typebox": "0.34.41",
    "bits-ui": "2.20.0",
    "clsx": "2.1.1",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "5.4.296",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.49.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.1",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "svelte": "5.45.6",
    "svelte-check": "4.3.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.13"
  }
}
